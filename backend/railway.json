{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npx nest build && npx prisma generate"
  },
  "deploy": {
    "startCommand": "node dist/src/main.js",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/api/v1/health"
  }
}
